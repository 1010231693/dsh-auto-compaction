    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1010231693/dsh-auto-compaction.git",
    "directory": "packages/dsh-auto-compaction-engine"
  },
  "homepage": "https://github.com/1010231693/dsh-auto-compaction#readme",
  "bugs": {
    "url": "https://github.com/1010231693/dsh-auto-compaction/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "compaction",
    "context",
    "handoff",
    "llm",
    "local-llm"
  ],
  "files": [
    "lib",
    "scripts",
    "README.md"
  ],
