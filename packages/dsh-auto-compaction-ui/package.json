{
  "name": "dsh-auto-compaction-ui",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "description": "Settings page (设置 → 会话压缩) for dsh-auto-compaction. Writes the live settings sidecar the engine reads.",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1010231693/dsh-auto-compaction.git",
    "directory": "packages/dsh-auto-compaction-ui"
  },
  "homepage": "https://github.com/1010231693/dsh-auto-compaction#readme",
  "bugs": {
    "url": "https://github.com/1010231693/dsh-auto-compaction/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "compaction",
    "settings-ui"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
