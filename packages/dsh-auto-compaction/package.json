{
  "name": "dsh-auto-compaction",
  "version": "0.2.1",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "description": "Settings page (设置 → 会话压缩) for A session auto-compaction plugin that is friendly to local models: compaction never makes the local engine re-read history, saving a lot of time; the trigger point and the saved content of the compacted session are user-configurable.",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1010231693/dsh-auto-compaction.git",
    "directory": "packages/dsh-auto-compaction"
  },
  "homepage": "https://github.com/1010231693/dsh-auto-compaction#readme",
  "bugs": {
    "url": "https://github.com/1010231693/dsh-auto-compaction/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "compaction",
    "settings-ui"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "dsh-auto-compaction-engine": "^0.2.1"
  }
}
